{
  "name": "flightclub-shell",
  "private": true,
  "type": "module",
  "scripts": {
    "engine": "cd .. && ./gradlew :web:generateJavaScript",
    "dev": "npm run engine && vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../tsconfig.worker.json",
    "build": "npm run engine && npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "playwright": "^1.63.0",
    "terser": "^5.51.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.129.0"
  }
}
